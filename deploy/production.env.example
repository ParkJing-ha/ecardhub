# Copy to a private .env file and supply real secrets; do not commit that file.
POSTGRES_DB=apexecard
POSTGRES_USER=apexecard
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
HTTP_PORT=8080
HTTP_BIND=127.0.0.1
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
DJANGO_DB_POOL_MAX=4
# This internal HTTP listener needs a trusted HTTPS ingress for public use.
# Configure nginx/TLS before enabling redirect, and forward only trusted headers.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
APEXECARD_LOAD_TEST_FIXTURES=false
